{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-principles:schema:project-context:0.10.0",
  "title": "Software Engineering Project Context",
  "description": "Explicit repository configuration or normalized detected project context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specification_version",
    "selection_mode",
    "project"
  ],
  "properties": {
    "specification_version": {
      "type": "string",
      "const": "0.10.0"
    },
    "selection_mode": {
      "type": "string",
      "enum": [
        "automatic-with-visible-result",
        "propose",
        "manual"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type"
      ],
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/evidencedArtifactType"
        },
        "secondary_artifact_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidencedArtifactType"
          },
          "default": []
        },
        "project_stage": {
          "$ref": "#/$defs/evidencedProjectStage"
        },
        "exposure": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidencedExposure"
          },
          "default": []
        },
        "domain_complexity": {
          "$ref": "#/$defs/evidencedDomainComplexity"
        },
        "architecture_authority": {
          "$ref": "#/$defs/evidencedArchitectureAuthority"
        },
        "state_model": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidencedStateModel"
          },
          "default": []
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "security": {
          "$ref": "#/$defs/evidencedLevel"
        },
        "reliability": {
          "$ref": "#/$defs/evidencedLevel"
        },
        "backward_compatibility": {
          "$ref": "#/$defs/evidencedLevel"
        },
        "latency_sensitivity": {
          "$ref": "#/$defs/evidencedLevel"
        },
        "throughput_sensitivity": {
          "$ref": "#/$defs/evidencedLevel"
        },
        "memory_sensitivity": {
          "$ref": "#/$defs/evidencedLevel"
        },
        "determinism": {
          "$ref": "#/$defs/evidencedLevel"
        },
        "accessibility": {
          "$ref": "#/$defs/evidencedLevel"
        }
      },
      "default": {}
    },
    "runtime": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidencedRuntime"
      },
      "default": []
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidencedTechnology"
      },
      "default": []
    },
    "frameworks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidencedTechnology"
      },
      "default": []
    },
    "technologies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidencedTechnology"
      },
      "default": []
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/identifier"
        },
        "modifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "default": []
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill_modes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/identifier"
          },
          "default": {}
        },
        "required_patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          },
          "default": []
        },
        "prohibited_patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          },
          "default": []
        },
        "notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          },
          "default": []
        }
      },
      "default": {}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 80
    },
    "confidence": {
      "type": "string",
      "enum": [
        "explicit",
        "observed",
        "inferred-high",
        "inferred-low",
        "unknown"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true,
      "default": []
    },
    "artifactType": {
      "type": "string",
      "enum": [
        "web-application",
        "frontend-application",
        "fullstack-application",
        "backend-service",
        "reusable-library",
        "cli-application",
        "desktop-application",
        "mobile-application",
        "embedded-system",
        "data-pipeline",
        "background-worker",
        "distributed-system",
        "plugin-or-extension",
        "infrastructure-tool",
        "test-tooling",
        "unknown"
      ]
    },
    "projectStage": {
      "type": "string",
      "enum": [
        "prototype",
        "greenfield",
        "active-product",
        "mature-system",
        "legacy-modernization",
        "maintenance-only",
        "unknown"
      ]
    },
    "exposure": {
      "type": "string",
      "enum": [
        "private-local",
        "team-internal",
        "organization-internal",
        "external-integration",
        "public-api",
        "public-library",
        "extension-platform",
        "unknown"
      ]
    },
    "domainComplexity": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "unknown"
      ]
    },
    "architectureAuthority": {
      "type": "string",
      "enum": [
        "preserve-existing",
        "incremental-improvement",
        "redesign-allowed",
        "greenfield",
        "unknown"
      ]
    },
    "stateModel": {
      "type": "string",
      "enum": [
        "mostly-stateless",
        "request-scoped",
        "transactional",
        "shared-mutable",
        "event-driven",
        "eventually-consistent",
        "real-time",
        "offline-synchronized",
        "unknown"
      ]
    },
    "runtimeValue": {
      "type": "string",
      "enum": [
        "browser",
        "nodejs",
        "server",
        "edge",
        "serverless",
        "container",
        "desktop",
        "mobile",
        "embedded",
        "native",
        "wasm",
        "unknown"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "normal",
        "elevated",
        "high",
        "critical",
        "unknown"
      ]
    },
    "evidencedArtifactType": {
      "$ref": "#/$defs/evidencedValueBaseArtifact"
    },
    "evidencedProjectStage": {
      "$ref": "#/$defs/evidencedValueBaseStage"
    },
    "evidencedExposure": {
      "$ref": "#/$defs/evidencedValueBaseExposure"
    },
    "evidencedDomainComplexity": {
      "$ref": "#/$defs/evidencedValueBaseComplexity"
    },
    "evidencedArchitectureAuthority": {
      "$ref": "#/$defs/evidencedValueBaseAuthority"
    },
    "evidencedStateModel": {
      "$ref": "#/$defs/evidencedValueBaseState"
    },
    "evidencedRuntime": {
      "$ref": "#/$defs/evidencedValueBaseRuntime"
    },
    "evidencedLevel": {
      "$ref": "#/$defs/evidencedValueBaseLevel"
    },
    "evidencedTechnology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "evidencedValueBaseArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/artifactType"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "evidencedValueBaseStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/projectStage"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "evidencedValueBaseExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/exposure"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "evidencedValueBaseComplexity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/domainComplexity"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "evidencedValueBaseAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/architectureAuthority"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "evidencedValueBaseState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/stateModel"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "evidencedValueBaseRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/runtimeValue"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "evidencedValueBaseLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/level"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  }
}
