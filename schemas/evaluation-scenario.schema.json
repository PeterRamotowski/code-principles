{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-principles:schema:evaluation-scenario:0.7.0",
  "title": "Evaluation Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "description",
    "input",
    "expected",
    "forbidden"
  ],
  "properties": {
    "schema_version": {
      "const": "0.7.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "principles_under_test": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "minLength": 2,
        "maxLength": 100
      }
    }
  }
}
