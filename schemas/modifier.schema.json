{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-principles:schema:modifier:0.5.0",
  "title": "Engineering Modifier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "status",
    "description",
    "activation",
    "effects"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 100
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "experimental",
        "draft",
        "candidate",
        "stable",
        "deprecated"
      ]
    },
    "description": {
      "type": "string"
    },
    "activation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effects": {
      "type": "object"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "minLength": 2,
        "maxLength": 100
      }
    }
  }
}
