{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-principles:schema:skill:0.5.0",
  "title": "Engineering Skill Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "type",
    "status",
    "description",
    "normative_document",
    "applies_to",
    "activation",
    "priority",
    "outputs",
    "principles",
    "self_contained"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "type": {
      "enum": [
        "orchestrator",
        "core-skill"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "experimental",
        "draft",
        "candidate",
        "stable",
        "deprecated"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "normative_document": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+\\.md$"
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "signals"
      ],
      "properties": {
        "default": {
          "enum": [
            "always",
            "profile-selected",
            "task-relevant",
            "manual"
          ]
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "minLength": 2,
        "maxLength": 100
      },
      "uniqueItems": true
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "resolution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 100
          },
          "resolution": {
            "type": "string"
          },
          "escalate_when": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 100
          },
          "description": {
            "type": "string"
          },
          "emphasizes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "minLength": 2,
              "maxLength": 100
            }
          },
          "constrains": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "minLength": 2,
              "maxLength": 100
            }
          },
          "suppressed_behaviours": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "default_mode": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "minLength": 2,
        "maxLength": 100
      },
      "uniqueItems": true
    },
    "principles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "supporting"
      ],
      "properties": {
        "primary": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 100
          },
          "uniqueItems": true
        },
        "supporting": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 100
          },
          "uniqueItems": true
        },
        "constrains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 100
          },
          "uniqueItems": true
        }
      }
    },
    "self_contained": {
      "const": true
    },
    "external_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "purpose",
          "authority"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "authority": {
            "const": "supplementary-only"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "minLength": 2,
        "maxLength": 100
      },
      "uniqueItems": true
    }
  }
}
